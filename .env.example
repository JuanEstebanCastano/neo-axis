# ---- Postgres (18+ requerido por uuidv7()) ----
POSTGRES_USER=neoaxis
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=neoaxis
DATABASE_URL=postgres://neoaxis:change-me-in-prod@postgres:5432/neoaxis?sslmode=disable

# ---- API ----
NODE_ENV=development
API_PORT=3000
PUBLIC_WEB_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=neoaxis_session
SESSION_TTL_DAYS=30
SESSION_SECRET=generate-with-openssl-rand-hex-32

# ---- OAuth ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Object storage (S3-compatible: MinIO en dev) ----
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=neoaxis-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- SMTP (Mailpit en dev) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Neo Axis <no-reply@neoaxis.local>"

# ---- Worker ----
WORKER_BATCH_SIZE=25
WORKER_POLL_MS=5000
WORKER_MAX_ATTEMPTS=5
