# ---- Postgres ----
# Opción A) Desarrollo local con Docker (PostgreSQL 18, uuidv7() nativa).
POSTGRES_USER=neoaxis
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=neoaxis
DATABASE_URL=postgres://neoaxis:change-me-in-prod@postgres:5432/neoaxis?sslmode=disable

# Opción B) Supabase (PostgreSQL 17 + app.uuidv7() de compatibilidad, ya aplicado).
# Usá el "Session pooler" (puerto 5432): mantiene prepared statements y respeta
# el search_path=app,public que fija el código. El Transaction pooler (6543) NO sirve.
# El pooler usa un certificado firmado por la CA raíz de Supabase (no está en el
# almacén del sistema), por eso conectamos con verify-full + sslrootcert apuntando
# a la CA incluida en el repo (ops/certs/supabase-root-2021-ca.crt).
# Reemplazá [PASSWORD] por la contraseña de la base (Project Settings > Database).
# Si tiene símbolos (@ : / ? # * etc.), codificalos en URL (ej. * -> %2A).
# Ejecutá los comandos desde la raíz del repo para que la ruta relativa resuelva.
# DATABASE_URL=postgres://postgres.dkdofozfgaajxyiocsul:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=ops/certs/supabase-root-2021-ca.crt

# ---- API ----
NODE_ENV=development
API_PORT=3000
# Uno o varios orígenes permitidos (CORS), separados por coma.
PUBLIC_WEB_ORIGIN=http://localhost:5173
# 'lax' en dev (mismo origen por proxy). 'none' si el front y la API quedan en
# dominios distintos al desplegar (requiere HTTPS, se fuerza Secure).
COOKIE_SAMESITE=lax
SESSION_COOKIE_NAME=neoaxis_session
SESSION_TTL_DAYS=30
SESSION_SECRET=generate-with-openssl-rand-hex-32

# ---- OAuth ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Object storage (S3-compatible: MinIO en dev) ----
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=neoaxis-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- SMTP (Mailpit en dev) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Neo Axis <no-reply@neoaxis.local>"

# ---- Worker ----
WORKER_BATCH_SIZE=25
WORKER_POLL_MS=5000
WORKER_MAX_ATTEMPTS=5

# ---- Recomendaciones (opcional: Edge Function de embeddings gte-small) ----
# Si no se configuran, los endpoints /recomendaciones responden 503.
# EMBEDDINGS_TOKEN = API key anon de Supabase (pública, es un JWT).
EMBEDDINGS_URL=https://<project_ref>.supabase.co/functions/v1/embed
EMBEDDINGS_TOKEN=
