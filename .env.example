# ====================================================================
# .env del VPS (producción) — lo usan api y worker (docker-compose.yml).
# El frontend (web) NO usa este archivo: su única variable (VITE_API_URL) se
# configura en Vercel (ver apps/web/.env.example).
# Para infra LOCAL de desarrollo (postgres/minio/mailpit) ver docker-compose.dev.yml.
# No pongas valores reales ni secretos en este archivo de ejemplo.
# ====================================================================

# ---- Postgres (Supabase) ----
# Session pooler (puerto 5432) + verify-full + la CA del repo (ruta relativa a
# la raíz). El password va dentro de la URL; si tiene símbolos, URL-encodealos.
DATABASE_URL=postgres://postgres.<project_ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=ops/certs/supabase-root-2021-ca.crt

# ---- API ----
NODE_ENV=production
API_PORT=3000
# Dominio(s) del frontend en Vercel (coma-separados). Los previews se aceptan por
# regex anclado al slug en apps/api/src/lib/origins.ts (no hace falta listarlos).
PUBLIC_WEB_ORIGIN=https://WEB_DOMAIN_PLACEHOLDER
# Front y API en dominios distintos -> cookie cross-site. 'none' fuerza Secure.
COOKIE_SAMESITE=none
SESSION_COOKIE_NAME=neoaxis_session
SESSION_TTL_DAYS=30
SESSION_SECRET=generate-with-openssl-rand-hex-32

# ---- GitHub: snippets versionados como gists (opcional) ----
# Las CUATRO van juntas: si ponés GITHUB_CLIENT_ID y falta alguna, el API no
# arranca y te dice cuál. Sin ninguna, la integración queda apagada.
# Cómo crear la OAuth App y qué permisos pide: docs/08-github-snippets.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Tiene que coincidir EXACTAMENTE con el "Authorization callback URL" de la
# OAuth App en GitHub.
GITHUB_CALLBACK_URL=https://API_DOMAIN_PLACEHOLDER/api/v1/github/callback
# Clave AES-256 con la que se cifran los tokens de GitHub guardados.
# Generala con: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ---- OAuth de ingreso (opcional, todavía sin implementar) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Object storage: Supabase Storage (endpoint S3-compatible) ----
# Claves S3 en: Supabase Dashboard > Storage > S3 Access Keys.
# El código (lib/storage.ts) no cambia: es S3 genérico.
S3_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<region>
S3_BUCKET=neoaxis-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ---- Correo (lo usa el worker) ----
# Transporte: "smtp" (nodemailer) o "mailersend" (API HTTP, puerto 443).
# En hostings que bloquean SMTP saliente (p. ej. Railway en planes bajos) usar
# "mailersend", que va por HTTPS y no depende de los puertos SMTP.
MAIL_TRANSPORT=smtp
# Remitente. El dominio debe estar verificado en el proveedor (MailerSend/SMTP).
MAIL_FROM="Neo Axis <no-reply@WEB_DOMAIN_PLACEHOLDER>"

# -- Opción A: SMTP (requerido si MAIL_TRANSPORT=smtp; en dev se usa Mailpit) --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -- Opción B: MailerSend API (requerido si MAIL_TRANSPORT=mailersend) --
# API token de MailerSend (Dashboard -> Integrations -> API tokens).
MAILERSEND_API_KEY=

# ---- Worker ----
WORKER_BATCH_SIZE=25
WORKER_POLL_MS=5000
WORKER_MAX_ATTEMPTS=5

# ---- Recomendaciones (Edge Function de embeddings gte-small en Supabase) ----
# EMBEDDINGS_TOKEN = API key anon de Supabase (pública, es un JWT). Sin esto,
# /recomendaciones responde 503.
EMBEDDINGS_URL=https://<project_ref>.supabase.co/functions/v1/embed
EMBEDDINGS_TOKEN=

# ====================================================================
# DESPLIEGUE EN VPS con docker-compose.yml
#   API_DOMAIN = dominio público de la API; Caddy pide el certificado TLS para
#   él. Si falta, Caddy cae a localhost y la API NO será accesible por internet.
# API_DOMAIN=api.midominio.com
#
# Nota: el compose de producción fuerza NODE_ENV=production aunque este archivo
# diga development; la imagen no trae pino-pretty y el proceso moriría.
# ====================================================================

# ====================================================================
# DESARROLLO LOCAL (docker-compose.dev.yml) — alternativa a los valores de arriba:
#   DATABASE_URL=postgres://neoaxis:neoaxis@postgres:5432/neoaxis?sslmode=disable
#   PUBLIC_WEB_ORIGIN=http://localhost:5173 / COOKIE_SAMESITE=lax / NODE_ENV=development
#   S3_ENDPOINT=http://minio:9000 / S3_ACCESS_KEY=minioadmin / S3_SECRET_KEY=minioadmin
#   SMTP_HOST=mailpit / SMTP_PORT=1025
#
# docker-compose.dev.yml NO lee este archivo: trae sus propias credenciales
# locales (neoaxis/neoaxis/neoaxis, minioadmin/minioadmin) para no migrar nunca
# contra Supabase por accidente. Para cambiarlas, exportá DEV_POSTGRES_USER,
# DEV_POSTGRES_PASSWORD, DEV_POSTGRES_DB, DEV_S3_ACCESS_KEY, DEV_S3_SECRET_KEY
# o DEV_S3_BUCKET.
# ====================================================================
