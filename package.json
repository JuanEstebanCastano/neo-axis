{
  "name": "neo-axis",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "docker compose up --build",
    "db:up": "dbmate --migrations-dir ./db/migrations up",
    "db:down": "dbmate --migrations-dir ./db/migrations down",
    "db:new": "dbmate --migrations-dir ./db/migrations new",
    "db:types": "kysely-codegen --dialect postgres --schema app --out-file packages/db/src/schema.d.ts",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "node --test apps/**/dist/**/*.test.js"
  },
  "devDependencies": {
    "kysely-codegen": "^0.18.5",
    "typescript": "^5.7.3",
    "eslint": "^9.18.0"
  },
  "packageManager": "pnpm@9.15.4"
}
