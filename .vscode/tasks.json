{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: levantar todo (Docker)",
      "type": "shell",
      "command": "docker compose up --build",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "dev: apagar",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "pnpm typecheck",
      "problemMatcher": ["$tsc"],
      "group": "test"
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "pnpm lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "db: aplicar migraciones",
      "type": "shell",
      "command": "pnpm db:up",
      "problemMatcher": []
    },
    {
      "label": "db: regenerar tipos",
      "type": "shell",
      "command": "pnpm db:types",
      "problemMatcher": []
    }
  ]
}
